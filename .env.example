# ===========================================
# LaDolce App Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit the .env file to git!
# ===========================================

# Your Odoo/Backend API URL
# Use localhost for development, or your server IP/domain for production
API_BASE_URL=http://YOUR_SERVER_IP:8069/api

# Odoo database name (optional - backend can auto-detect)
API_DB=ladolce

# Google Maps API Key (for maps and directions features)
# Get from: https://developers.google.com/maps/documentation/android-sdk/get-api-key
GOOGLE_MAPS_API_KEY=

# Google Server Client ID for OAuth sign-in
# Get from: Firebase Console → Authentication → Google → Web SDK configuration
GOOGLE_SERVER_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
